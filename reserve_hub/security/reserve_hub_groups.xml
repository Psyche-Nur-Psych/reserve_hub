<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_reserve_hub" model="ir.module.category">
            <field name="name">ReserveHub</field>
            <field name="description">Manage resource bookings, reservations, and approvals.</field>
            <field name="sequence">25</field>
        </record>

        <!-- Employee Group -->
        <record id="group_reserve_hub_employee" model="res.groups">
            <field name="name">ReserveHub / Employee</field>
            <field name="comment">Employees can view resources and create booking requests.</field>
        </record>

        <!-- Manager Group -->
        <record id="group_reserve_hub_manager" model="res.groups">
            <field name="name">ReserveHub / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_reserve_hub_employee'))]"/>
            <field name="comment">Managers can approve/reject bookings and manage resources.</field>
        </record>

        <!-- Administrator Group -->
        <record id="group_reserve_hub_admin" model="res.groups">
            <field name="name">ReserveHub / Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_reserve_hub_manager'))]"/>
            <field name="comment">Full administrative access to ReserveHub configuration and data.</field>
        </record>
    </data>
</odoo>
