<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Resource Category Tree / List View -->
    <record id="view_resource_category_tree" model="ir.ui.view">
        <field name="name">resource.category.tree</field>
        <field name="model">resource.category</field>
        <field name="arch" type="xml">
            <list string="Resource Categories" default_order="name" editable="bottom">
                <field name="name" class="fw-bold text-primary"/>
                <field name="color" widget="color"/>
                <field name="description"/>
                <field name="resource_count" widget="badge" class="bg-primary-subtle text-primary border border-primary-subtle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Resource Category Form View -->
    <record id="view_resource_category_form" model="ir.ui.view">
        <field name="name">resource.category.form</field>
        <field name="model">resource.category</field>
        <field name="arch" type="xml">
            <form string="Resource Category">
                <sheet>
                    <field name="id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_reserve_resource)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-cubes"
                                context="{'search_default_category_id': id}">
                            <field name="resource_count" widget="statinfo" string="Resources"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Category Name (e.g. Conference Rooms, Vehicles, Laptops)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Category Customization">
                            <field name="color" widget="color"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Guidelines" name="description">
                            <field name="description" placeholder="Add guidelines for booking resources in this category..." nolabel="1"/>
                        </page>
                        <page string="Associated Resources" name="resources">
                            <field name="resource_ids" readonly="1">
                                <list>
                                    <field name="name" class="fw-bold"/>
                                    <field name="code"/>
                                    <field name="location"/>
                                    <field name="capacity"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'available'"
                                           decoration-warning="state == 'maintenance'"
                                           decoration-danger="state == 'archived'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Resource Category Action (Resources Overview) -->
    <record id="action_resource_category" model="ir.actions.act_window">
        <field name="name">Categories Overview</field>
        <field name="res_model">resource.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Resource Category!
            </p>
            <p>
                Group resources into logical categories such as Meeting Rooms, Laptops, Vehicles, and Workstations.
            </p>
        </field>
    </record>

    <!-- Resource Category Config Action (Configuration Management) -->
    <record id="action_resource_category_config" model="ir.actions.act_window">
        <field name="name">Category Settings &amp; Rules</field>
        <field name="res_model">resource.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Category Configuration
            </p>
            <p>
                Configure color tags, descriptions, active toggles, and resource rules for all asset categories.
            </p>
        </field>
    </record>
</odoo>
