<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root App Menu -->
    <menuitem id="menu_reserve_hub_root"
              name="ReserveHub"
              action="action_reserve_booking_all"
              web_icon="reserve_hub,static/description/icon.png"
              sequence="10"/>

    <!-- Bookings Category -->
    <menuitem id="menu_reserve_booking_root"
              name="📅 Bookings"
              parent="menu_reserve_hub_root"
              sequence="10"/>

    <menuitem id="menu_reserve_booking_calendar"
              name="📅 Booking Calendar"
              parent="menu_reserve_booking_root"
              action="action_reserve_booking_all"
              sequence="10"/>

    <menuitem id="menu_reserve_booking_my"
              name="👤 My Bookings"
              parent="menu_reserve_booking_root"
              action="action_reserve_booking_my"
              sequence="20"/>

    <menuitem id="menu_reserve_booking_pending"
              name="⏳ Pending Approval"
              parent="menu_reserve_booking_root"
              action="action_reserve_booking_pending"
              sequence="30"/>

    <menuitem id="menu_reserve_booking_all"
              name="📋 All Bookings"
              parent="menu_reserve_booking_root"
              action="action_reserve_booking_all"
              sequence="40"/>

    <!-- Resources Category -->
    <menuitem id="menu_reserve_resource_root"
              name="🏢 Resources"
              parent="menu_reserve_hub_root"
              sequence="20"/>

    <menuitem id="menu_reserve_resource"
              name="🏢 Resource Directory"
              parent="menu_reserve_resource_root"
              action="action_reserve_resource"
              sequence="10"/>

    <menuitem id="menu_resource_category"
              name="🏷️ Resource Categories"
              parent="menu_reserve_resource_root"
              action="action_resource_category"
              sequence="20"/>

    <!-- Analytics & Dashboard Category (Dropdown Parent) -->
    <menuitem id="menu_reserve_analytics_root"
              name="📊 Analytics &amp; Dashboard"
              parent="menu_reserve_hub_root"
              sequence="30"/>

    <menuitem id="menu_reserve_analytics_pivot"
              name="📈 Pivot Matrix"
              parent="menu_reserve_analytics_root"
              action="action_reserve_analytics_pivot"
              sequence="10"/>

    <menuitem id="menu_reserve_analytics_graph"
              name="📊 Utilization Charts"
              parent="menu_reserve_analytics_root"
              action="action_reserve_analytics_graph"
              sequence="20"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_reserve_config"
              name="⚙️ Configuration"
              parent="menu_reserve_hub_root"
              sequence="40"/>

    <menuitem id="menu_reserve_config_settings"
              name="⚙️ General Settings"
              parent="menu_reserve_config"
              action="action_reserve_hub_config_settings"
              sequence="10"/>

    <menuitem id="menu_reserve_config_groups"
              name="🛡️ Access Rights &amp; Groups"
              parent="menu_reserve_config"
              action="base.action_res_groups"
              sequence="20"/>
</odoo>
