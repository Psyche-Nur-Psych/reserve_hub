<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree / List View -->
    <record id="view_reserve_resource_tree" model="ir.ui.view">
        <field name="name">reserve.resource.tree</field>
        <field name="model">reserve.resource</field>
        <field name="arch" type="xml">
            <list string="Reservable Resources">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'available'" 
                       decoration-warning="state == 'maintenance'" 
                       decoration-danger="state == 'archived'"/>
                <field name="booking_count"/>
            </list>
        </field>
    </record>

    <!-- Kanban View for Odoo 19 -->
    <record id="view_reserve_resource_kanban" model="ir.ui.view">
        <field name="name">reserve.resource.kanban</field>
        <field name="model">reserve.resource</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="state"/>
                <field name="image_1920"/>
                <field name="booking_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex align-items-start gap-2 p-2">
                            <field name="image_1920" widget="image" class="o_kanban_image img-thumbnail me-2" style="width: 64px; height: 64px; object-fit: cover;"/>
                            <div class="flex-grow-1">
                                <div class="fw-bold fs-5 text-primary">
                                    <field name="name"/>
                                </div>
                                <div t-if="record.code.raw_value" class="text-muted small">
                                    Code: <field name="code"/>
                                </div>
                                <div class="mt-1">
                                    <span class="badge bg-secondary me-1"><field name="category_id"/></span>
                                    <span t-if="record.capacity.raw_value &gt; 0" class="badge bg-info">
                                        <field name="capacity"/> Persons
                                    </span>
                                </div>
                                <div class="mt-2 d-flex justify-content-between align-items-center">
                                    <span t-if="record.state.raw_value == 'available'" class="badge bg-success">Available</span>
                                    <span t-if="record.state.raw_value == 'maintenance'" class="badge bg-warning text-dark">Maintenance</span>
                                    <span t-if="record.state.raw_value == 'archived'" class="badge bg-danger">Out of Service</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_reserve_resource_form" model="ir.ui.view">
        <field name="name">reserve.resource.form</field>
        <field name="model">reserve.resource</field>
        <field name="arch" type="xml">
            <form string="Reservable Resource">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,maintenance,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Resource Name (e.g. Executive Boardroom A)"/>
                        </h1>
                        <div class="d-flex align-items-center gap-2">
                            <label for="code" string="Resource Code:"/>
                            <field name="code" placeholder="e.g. RM-101"/>
                        </div>
                    </div>
                    <group>
                        <group string="Resource Classification">
                            <field name="category_id"/>
                            <field name="location" placeholder="e.g. Building 2, Floor 3"/>
                            <field name="capacity"/>
                        </group>
                        <group string="Management &amp; Status">
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Specifications &amp; Details" name="description">
                            <field name="description" placeholder="Add equipment specs, usage guidelines, features..." nolabel="1"/>
                        </page>
                        <page string="Booking History" name="bookings">
                            <field name="booking_ids" readonly="1">
                                <list default_order="start_datetime desc">
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'submitted'"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-muted="state in ('cancelled', 'done')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_reserve_resource_search" model="ir.ui.view">
        <field name="name">reserve.resource.search</field>
        <field name="model">reserve.resource</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <field name="category_id"/>
                <field name="responsible_id"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('state', '=', 'maintenance')]"/>
                <group name="groupby">
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_reserve_resource" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">reserve.resource</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_reserve_resource_search"/>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Reservable Resource!
            </p>
            <p>
                Manage conference rooms, projectors, company vehicles, and hardware assets available for booking.
            </p>
        </field>
    </record>
</odoo>
