<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Booking List View -->
    <record id="view_reserve_booking_tree" model="ir.ui.view">
        <field name="name">reserve.booking.tree</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <list string="Booking Requests" default_order="start_datetime desc" decoration-muted="state == 'cancelled'" decoration-danger="state == 'rejected'" decoration-success="state == 'approved'">
                <field name="name" class="fw-bold text-primary"/>
                <field name="title"/>
                <field name="resource_id" widget="many2one"/>
                <field name="category_id" widget="badge" class="bg-primary-subtle text-primary border border-primary-subtle"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration" widget="float_time"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('cancelled', 'done')"/>
            </list>
        </field>
    </record>

    <!-- Booking Form View -->
    <record id="view_reserve_booking_form" model="ir.ui.view">
        <field name="name">reserve.booking.form</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <form string="Booking Request">
                <header>
                    <!-- Action Buttons -->
                    <button name="action_submit"
                            string="Submit Request"
                            type="object"
                            class="btn-primary fw-bold px-3"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success fw-bold px-3"
                            groups="reserve_hub.group_reserve_hub_manager"
                            invisible="state != 'submitted'"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger fw-bold px-3"
                            groups="reserve_hub.group_reserve_hub_manager"
                            invisible="state != 'submitted'"/>

                    <button name="action_mark_done"
                            string="Mark Completed"
                            type="object"
                            class="btn-info text-white fw-bold px-3"
                            groups="reserve_hub.group_reserve_hub_manager"
                            invisible="state != 'approved'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary px-3"
                            invisible="state in ('cancelled', 'done')"/>

                    <button name="action_set_to_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-outline-secondary px-3"
                            groups="reserve_hub.group_reserve_hub_manager"
                            invisible="state not in ('rejected', 'cancelled')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted small">Booking Reference</span>
                        <h1>
                            <field name="name" readonly="1" class="text-primary"/>
                        </h1>
                        <div class="mb-3">
                            <label for="title" class="oe_edit_only fw-bold"/>
                            <field name="title" placeholder="Booking Title / Purpose (e.g. Q3 Strategy Meeting)" readonly="state not in ('draft', 'submitted')"/>
                        </div>
                    </div>
                    <group>
                        <group string="Resource &amp; Requester">
                            <field name="resource_id" options="{'no_create': True}" readonly="state not in ('draft', 'submitted')"/>
                            <field name="category_id" readonly="1"/>
                            <field name="user_id" widget="many2one_avatar_user" readonly="state not in ('draft', 'submitted')"/>
                        </group>
                        <group string="Schedule &amp; Timing">
                            <field name="start_datetime" readonly="state not in ('draft', 'submitted')"/>
                            <field name="end_datetime" readonly="state not in ('draft', 'submitted')"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="Approval &amp; Audit Trail" invisible="state in ('draft', 'submitted')">
                        <group>
                            <field name="approved_by_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                        <group invisible="state != 'rejected'">
                            <field name="rejection_reason" readonly="state != 'submitted'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes &amp; Details" name="description">
                            <field name="description" placeholder="Add meeting agenda, setup requirements, special requests..." readonly="state not in ('draft', 'submitted')"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Booking Calendar View -->
    <record id="view_reserve_booking_calendar" model="ir.ui.view">
        <field name="name">reserve.booking.calendar</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <calendar string="Booking Calendar"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      color="resource_id"
                      mode="month"
                      quick_create="0"
                      event_open_popup="1">
                <field name="name"/>
                <field name="title"/>
                <field name="resource_id"/>
                <field name="user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Booking Search View -->
    <record id="view_reserve_booking_search" model="ir.ui.view">
        <field name="name">reserve.booking.search</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <search string="Search Bookings">
                <field name="name"/>
                <field name="title"/>
                <field name="resource_id"/>
                <field name="category_id"/>
                <field name="user_id"/>

                <filter string="My Bookings" name="my_bookings" domain="[('user_id', '=', uid)]"/>
                <filter string="Pending Approval" name="pending" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Completed" name="done" domain="[('state', '=', 'done')]"/>

                <group name="groupby">
                    <filter string="Resource" name="group_by_resource" context="{'group_by': 'resource_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_by_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Actions -->
    <record id="action_reserve_booking_all" model="ir.actions.act_window">
        <field name="name">All Bookings</field>
        <field name="res_model">reserve.booking</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_reserve_booking_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Booking Request!
            </p>
            <p>
                Reserve conference rooms, company vehicles, projectors, and IT hardware.
            </p>
        </field>
    </record>

    <record id="action_reserve_booking_my" model="ir.actions.act_window">
        <field name="name">My Bookings</field>
        <field name="res_model">reserve.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_reserve_booking_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_bookings': 1}</field>
    </record>

    <record id="action_reserve_booking_pending" model="ir.actions.act_window">
        <field name="name">Pending Approval</field>
        <field name="res_model">reserve.booking</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_reserve_booking_search"/>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
