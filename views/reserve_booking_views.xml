<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_reserve_booking_form" model="ir.ui.view">
        <field name="name">reserve.booking.form</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <form string="Booking Request">
                <header>
                    <button name="action_submit"
                            string="Submit Request"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="reserve_hub.group_reserve_hub_manager"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="reserve_hub.group_reserve_hub_manager"/>

                    <button name="action_mark_done"
                            string="Mark Completed"
                            type="object"
                            class="btn-info"
                            invisible="state != 'approved'"/>

                    <button name="action_cancel"
                            string="Cancel Booking"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('cancelled', 'done')"/>

                    <button name="action_set_to_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-outline-secondary"
                            invisible="state not in ('cancelled', 'rejected')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Booking Reference</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <label for="title" class="oe_edit_only"/>
                        <h2>
                            <field name="title" placeholder="e.g. Q3 Product Roadmap Strategy Workshop" readonly="state in ('approved', 'rejected', 'done', 'cancelled')"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Resource &amp; Requester">
                            <field name="resource_id" options="{'no_create': True}" readonly="state in ('approved', 'rejected', 'done', 'cancelled')"/>
                            <field name="category_id"/>
                            <field name="user_id" widget="many2one_avatar_user" readonly="state in ('approved', 'rejected', 'done', 'cancelled')"/>
                        </group>
                        <group string="Schedule &amp; Timing">
                            <field name="start_datetime" readonly="state in ('approved', 'rejected', 'done', 'cancelled')"/>
                            <field name="end_datetime" readonly="state in ('approved', 'rejected', 'done', 'cancelled')"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>

                    <group string="Approval &amp; Audit Metadata" invisible="state not in ('approved', 'rejected')">
                        <group>
                            <field name="approved_by_id" widget="many2one_avatar_user"/>
                            <field name="approval_date"/>
                        </group>
                        <group>
                            <field name="rejection_reason" invisible="state != 'rejected'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes &amp; Agenda" name="notes">
                            <field name="description" placeholder="Specify meeting agenda, equipment requirements, special instructions..." readonly="state in ('approved', 'rejected', 'done', 'cancelled')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_reserve_booking_tree" model="ir.ui.view">
        <field name="name">reserve.booking.tree</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <list string="Booking Requests" default_order="start_datetime desc" decoration-info="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state in ('cancelled', 'done')">
                <field name="name"/>
                <field name="title"/>
                <field name="resource_id"/>
                <field name="category_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration" widget="float_time" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('cancelled', 'done')"/>
            </list>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_reserve_booking_calendar" model="ir.ui.view">
        <field name="name">reserve.booking.calendar</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <calendar string="Resource Booking Calendar"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      color="resource_id"
                      quick_create="0"
                      event_open_popup="true">
                <field name="name"/>
                <field name="title"/>
                <field name="resource_id"/>
                <field name="user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_reserve_booking_search" model="ir.ui.view">
        <field name="name">reserve.booking.search</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <search string="Search Bookings">
                <field name="name"/>
                <field name="title"/>
                <field name="resource_id"/>
                <field name="category_id"/>
                <field name="user_id"/>
                
                <!-- Filters -->
                <filter string="My Bookings" name="my_bookings" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Pending Approval" name="pending_approval" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Completed" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('start_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('start_datetime', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter string="Resource" name="group_by_resource" context="{'group_by': 'resource_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Start Date" name="group_by_start_datetime" context="{'group_by': 'start_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Actions -->
    <record id="action_reserve_booking_all" model="ir.actions.act_window">
        <field name="name">All Bookings</field>
        <field name="res_model">reserve.booking</field>
        <field name="view_mode">calendar,list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Booking Request!
            </p>
            <p>
                Select a shared resource and schedule your start/end time. Requests will enter the manager approval queue.
            </p>
        </field>
    </record>

    <record id="action_reserve_booking_my" model="ir.actions.act_window">
        <field name="name">My Bookings</field>
        <field name="res_model">reserve.booking</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_my_bookings': 1}</field>
    </record>

    <record id="action_reserve_booking_pending" model="ir.actions.act_window">
        <field name="name">Pending Approval</field>
        <field name="res_model">reserve.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_pending_approval': 1}</field>
    </record>
</odoo>
