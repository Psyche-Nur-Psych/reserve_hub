<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pivot View -->
    <record id="view_reserve_booking_pivot" model="ir.ui.view">
        <field name="name">reserve.booking.pivot</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <pivot string="Resource Utilization Analysis" sample="1">
                <field name="resource_id" type="row"/>
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_reserve_booking_graph" model="ir.ui.view">
        <field name="name">reserve.booking.graph</field>
        <field name="model">reserve.booking</field>
        <field name="arch" type="xml">
            <graph string="Booking Metrics Dashboard" type="bar" sample="1">
                <field name="resource_id"/>
                <field name="duration" type="measure"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_reserve_dashboard" model="ir.actions.act_window">
        <field name="name">Analytics &amp; Statistics</field>
        <field name="res_model">reserve.booking</field>
        <field name="view_mode">pivot,graph,calendar,list</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No booking metrics available yet!
            </p>
            <p>
                Analyze resource utilization, total reserved hours, and request approval statistics here.
            </p>
        </field>
    </record>
</odoo>
