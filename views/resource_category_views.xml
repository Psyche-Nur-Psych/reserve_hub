<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_resource_category_tree" model="ir.ui.view">
        <field name="name">resource.category.tree</field>
        <field name="model">resource.category</field>
        <field name="arch" type="xml">
            <list string="Resource Categories">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="resource_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_resource_category_form" model="ir.ui.view">
        <field name="name">resource.category.form</field>
        <field name="model">resource.category</field>
        <field name="arch" type="xml">
            <form string="Resource Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_resources"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes">
                            <field name="resource_count" widget="statinfo" string="Resources"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Category Name (e.g. Meeting Rooms, Vehicles)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Specify details about this category..." nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Associated Resources" name="resources">
                            <field name="resource_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="location"/>
                                    <field name="capacity"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_resource_category_search" model="ir.ui.view">
        <field name="name">resource.category.search</field>
        <field name="model">resource.category</field>
        <field name="arch" type="xml">
            <search string="Search Resource Categories">
                <field name="name"/>
                <field name="description"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_resource_category" model="ir.actions.act_window">
        <field name="name">Resource Categories</field>
        <field name="res_model">resource.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Resource Category!
            </p>
            <p>
                Categories help group shared organizational assets such as Meeting Rooms, Equipment, Company Cars, and Desks.
            </p>
        </field>
    </record>
</odoo>
