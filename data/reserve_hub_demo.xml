<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Resource Categories -->
        <record id="cat_meeting_rooms" model="resource.category">
            <field name="name">Meeting &amp; Conference Rooms</field>
            <field name="description">Spacious conference rooms equipped with video conferencing and whiteboards.</field>
            <field name="color">1</field>
        </record>

        <record id="cat_it_equipment" model="resource.category">
            <field name="name">IT &amp; AV Equipment</field>
            <field name="description">Portable projectors, presentation clickers, VR headsets, and audio systems.</field>
            <field name="color">4</field>
        </record>

        <record id="cat_vehicles" model="resource.category">
            <field name="name">Company Fleet &amp; Vehicles</field>
            <field name="description">Shared electric vehicles and shuttles for business travel.</field>
            <field name="color">3</field>
        </record>

        <record id="cat_workstations" model="resource.category">
            <field name="name">Flex Workstations &amp; Labs</field>
            <field name="description">Hot-desking pods, high-performance GPU workstations, and lab spaces.</field>
            <field name="color">7</field>
        </record>

        <!-- Reservable Resources -->
        <record id="res_boardroom_a" model="reserve.resource">
            <field name="name">Executive Boardroom A</field>
            <field name="code">RM-A101</field>
            <field name="category_id" ref="cat_meeting_rooms"/>
            <field name="location">Building A, Floor 3</field>
            <field name="capacity">20</field>
            <field name="description">High-end boardroom with 85-inch 4K display, video bar, teleconferencing, and catering setup.</field>
            <field name="state">available</field>
            <field name="responsible_id" ref="base.user_admin"/>
        </record>

        <record id="res_conf_room_b" model="reserve.resource">
            <field name="name">Innovation Conference Room B</field>
            <field name="code">RM-B204</field>
            <field name="category_id" ref="cat_meeting_rooms"/>
            <field name="location">Building B, Floor 2</field>
            <field name="capacity">8</field>
            <field name="description">Scrum-friendly meeting room with digital smartboard and glass whiteboard walls.</field>
            <field name="state">available</field>
            <field name="responsible_id" ref="base.user_admin"/>
        </record>

        <record id="res_projector_4k" model="reserve.resource">
            <field name="name">Ultra HD 4K Laser Projector</field>
            <field name="code">EQ-PRJ01</field>
            <field name="category_id" ref="cat_it_equipment"/>
            <field name="location">IT Support Desk, Cabinet 3</field>
            <field name="capacity">1</field>
            <field name="description">Portable 5000 lumens 4K wireless laser projector with HDMI and AirPlay support.</field>
            <field name="state">available</field>
            <field name="responsible_id" ref="base.user_admin"/>
        </record>

        <record id="res_ev_car" model="reserve.resource">
            <field name="name">Tesla Model 3 - Executive Fleet</field>
            <field name="code">VH-EV01</field>
            <field name="category_id" ref="cat_vehicles"/>
            <field name="location">Underground Parking Slot P-12</field>
            <field name="capacity">5</field>
            <field name="description">Long Range EV with charging cable and city parking pass included.</field>
            <field name="state">available</field>
            <field name="responsible_id" ref="base.user_admin"/>
        </record>

        <record id="res_gpu_lab_pod" model="reserve.resource">
            <field name="name">AI/ML GPU Workstation Pod 1</field>
            <field name="code">WS-GPU01</field>
            <field name="category_id" ref="cat_workstations"/>
            <field name="location">R&amp;D Wing, Room 402</field>
            <field name="capacity">2</field>
            <field name="description">Dual RTX 4090 workstation loaded with PyTorch, CUDA, and high-speed NVMe storage.</field>
            <field name="state">available</field>
            <field name="responsible_id" ref="base.user_admin"/>
        </record>

        <!-- Sample Bookings -->
        <record id="booking_sample_1" model="reserve.booking">
            <field name="name">BOOK/2026/00001</field>
            <field name="title">Q3 Product Strategy Alignment</field>
            <field name="resource_id" ref="res_boardroom_a"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="start_datetime" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="end_datetime" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 11:30:00')"/>
            <field name="description">Review Q3 product roadmap and align cross-functional engineering teams.</field>
            <field name="state">approved</field>
            <field name="approved_by_id" ref="base.user_admin"/>
            <field name="approval_date" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="booking_sample_2" model="reserve.booking">
            <field name="name">BOOK/2026/00002</field>
            <field name="title">Client Demo Presentation Prep</field>
            <field name="resource_id" ref="res_projector_4k"/>
            <field name="user_id" ref="base.user_demo"/>
            <field name="start_datetime" eval="(datetime.now() + timedelta(days=2)).strftime('%Y-%m-%d 14:00:00')"/>
            <field name="end_datetime" eval="(datetime.now() + timedelta(days=2)).strftime('%Y-%m-%d 16:00:00')"/>
            <field name="description">Need HD projector for key enterprise pitch presentation in Hall B.</field>
            <field name="state">submitted</field>
        </record>

        <record id="booking_sample_3" model="reserve.booking">
            <field name="name">BOOK/2026/00003</field>
            <field name="title">Client Onsite Visit - Transportation</field>
            <field name="resource_id" ref="res_ev_car"/>
            <field name="user_id" ref="base.user_demo"/>
            <field name="start_datetime" eval="(datetime.now() + timedelta(days=3)).strftime('%Y-%m-%d 08:00:00')"/>
            <field name="end_datetime" eval="(datetime.now() + timedelta(days=3)).strftime('%Y-%m-%d 17:00:00')"/>
            <field name="description">Driving to client headquarters for contract signing and system audit.</field>
            <field name="state">draft</field>
        </record>

        <record id="booking_sample_4" model="reserve.booking">
            <field name="name">BOOK/2026/00004</field>
            <field name="title">Sprint 24 Retrospective Meeting</field>
            <field name="resource_id" ref="res_conf_room_b"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="start_datetime" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d 15:00:00')"/>
            <field name="end_datetime" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d 16:30:00')"/>
            <field name="description">Bi-weekly sprint review and team retro.</field>
            <field name="state">done</field>
            <field name="approved_by_id" ref="base.user_admin"/>
            <field name="approval_date" eval="(datetime.now() - timedelta(days=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
